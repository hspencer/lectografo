{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "lectografo",
    "public": "static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "lectografo-api",
          "region": "us-central1"
        }
      }
    ]
  }
}
