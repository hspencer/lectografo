rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Candado por defecto: lo que no se abre explicitamente abajo, cerrado.
    // Ver specs/multiusuario.allium para las entidades e invariantes que
    // esto traduce (version minima: Persona, Biblioteca, Membresia).
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // OJO: no uses esto (ni nada que dependa de exists()/get() de OTRA
    // biblioteca) para autorizar un `list`/collectionGroup query que cruce
    // bibliotecas -- Firestore niega ese `list` si no puede demostrarse
    // valido de antemano, y en el primer login de una persona no existe
    // membresia alguna todavia (huevo y gallina). Por eso personas/{uid}
    // guarda su propio bibliotecaIds en vez de descubrirse con una query.
    function esMiembroDe(bibId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/bibliotecas/$(bibId)/membresias/$(request.auth.uid));
    }

    function esPropietariaDe(bibId) {
      return signedIn() &&
        get(/databases/$(database)/documents/bibliotecas/$(bibId)/membresias/$(request.auth.uid)).data.rol == 'propietaria';
    }

    function puedeEditar(bibId) {
      return signedIn() &&
        get(/databases/$(database)/documents/bibliotecas/$(bibId)/membresias/$(request.auth.uid)).data.rol in ['propietaria', 'editora'];
    }

    // Superusuario: get() sobre el propio documento (ruta fija, conocida),
    // no sobre el de otra persona -- no sufre el gotcha de esMiembroDe.
    function esAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/personas/$(request.auth.uid)).data.esAdmin == true;
    }

    // Persona: cada quien escribe solo su propio documento -- pero "su propio
    // documento" no puede significar "cualquier campo del documento". Sin
    // esto, cualquier persona autenticada podia escribirse esAdmin=true a si
    // misma, o poner el bibliotecaId de otra persona en bibliotecaIds y leer
    // y escribir su biblioteca entera (el middleware confia ciegamente en
    // ambos campos). Lectura propia, o de cualquiera si quien pide es admin.
    match /personas/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || esAdmin());

      // Alta: esAdmin nunca se auto-asigna (ausente == false), y la unica
      // biblioteca declarada tiene que ser una que esta misma persona acaba
      // de crear (creadoPor == uid) -- no una ajena.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('esAdmin', false) == false
        && request.resource.data.bibliotecaIds.size() == 1
        && get(/databases/$(database)/documents/bibliotecas/$(request.resource.data.bibliotecaIds[0])).data.creadoPor == uid;

      // Edicion: esAdmin no puede cambiar por este camino (se asigna fuera
      // de la app). bibliotecaIds sigue siendo de un solo elemento; si
      // cambia, el nuevo tiene que ser una biblioteca propia.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.esAdmin == resource.data.get('esAdmin', false)
        && request.resource.data.bibliotecaIds.size() == 1
        && (
          request.resource.data.bibliotecaIds == resource.data.get('bibliotecaIds', [])
          || get(/databases/$(database)/documents/bibliotecas/$(request.resource.data.bibliotecaIds[0])).data.creadoPor == uid
        );
    }

    // Biblioteca: "cada usuario, su biblioteca" (RegistrarPersona). Crear
    // exige declararse creadoPor = quien la crea; eso habilita la primera
    // Membresia propietaria de abajo. Leer y actualizar exige membresia
    // vigente (co-propiedad simetrica: cualquier propietaria actualiza), o
    // ser admin para leer.
    match /bibliotecas/{bibId} {
      allow create: if signedIn() && request.resource.data.creadoPor == request.auth.uid;
      allow read: if esMiembroDe(bibId) || esAdmin();
      allow update: if esPropietariaDe(bibId);
      allow delete: if false; // no modelado todavia

      match /membresias/{personaUid} {
        allow read: if esMiembroDe(bibId) || esAdmin();

        // Primera membresia (propietaria fundadora): solo quien creo la
        // biblioteca, sobre si misma, y solo si todavia no existe ninguna.
        allow create: if signedIn()
          && request.auth.uid == personaUid
          && request.resource.data.rol == 'propietaria'
          && get(/databases/$(database)/documents/bibliotecas/$(bibId)).data.creadoPor == request.auth.uid
          && !exists(/databases/$(database)/documents/bibliotecas/$(bibId)/membresias/$(personaUid));

        // Invitar o retirar a otra persona: solo una propietaria existente
        // (InvitarMiembro / RetirarMembresia en multiusuario.allium).
        allow create, update, delete: if esPropietariaDe(bibId);
      }

      // Transcripcion minima (titulo + texto crudo, sin grafo todavia).
      // import() en auth.js la crea; el procesamiento con Gemini (Cloud
      // Function, pendiente) la lee y escribe conceptos/relaciones aparte.
      match /transcripciones/{transId} {
        allow read: if esMiembroDe(bibId) || esAdmin();
        allow create: if puedeEditar(bibId) && request.resource.data.creadaPor == request.auth.uid;
        allow update, delete: if puedeEditar(bibId);
      }
    }
  }
}
