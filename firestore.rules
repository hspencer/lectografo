rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Candado por defecto: nada se lee ni escribe hasta modelar las reglas
    // reales de Persona/Biblioteca/Membresia (ver specs/multiusuario.allium).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
