# Lectógrafo — configuración local
# Copia este archivo a .env y edita los valores. Nunca commitear .env real.

# ─── Credenciales LLM ─────────────────────────────────────────────────────────
# Solo claves. El proveedor y el modelo se eligen en Configuración (lista en
# vivo de cada proveedor) y se guardan en Firestore, no aquí. En Cloud Run las
# claves llegan desde Secret Manager. Vertex AI usa la cuenta de servicio y LM
# Studio es local: ninguno necesita clave.
ANTHROPIC_API_KEY=   # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=      # https://platform.openai.com/api-keys
GEMINI_API_KEY=      # https://aistudio.google.com/app/apikey

# ─── Paths ────────────────────────────────────────────────────────────────────
# Carpeta de transcripciones de entrada (relativa al repo).
TRANSCRIPTS_DIR=transcripts

# Carpeta de grafos persistidos (relativa al repo).
GRAFOS_DIR=data/grafos

# ─── Comportamiento ───────────────────────────────────────────────────────────
# Idioma por defecto de las transcripciones (código ISO 639-1).
LANG_DEFAULT=es

# Confianza mínima de extracción bajo la cual el LLM debe marcar la tripleta como dudosa.
CONFIANZA_MINIMA_EXTRACCION=0.6

# Máximo de caracteres del transcript enviados en un solo prompt.
# Textos más largos se procesan en modo incremental (por lotes).
# Para modelos con contexto grande (ej. qwen2.5 128K) se puede subir a 120000.
MAX_CHARS_PROMPT=40000

# ─── Invitaciones por correo (SMTP con TLS) ─────────────────────────────────
# Configurar en Cloud Run; guardar SMTP_PASSWORD en Secret Manager.
# Nunca guardar la contraseña real en este archivo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=https://lectografo.web.app
