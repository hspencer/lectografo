-- allium: 3
-- transcripcion.allium

-- Scope: ciclo de vida de una transcripcion desde su ingesta hasta que
-- queda lista para la extraccion de grafo conceptual.
--
-- Includes:
--   - Fuentes de entrada (texto pegado, archivo local, URL de YouTube)
--   - Normalizacion: limpieza, particion en parrafos, preservacion de timestamps
--   - Estados desde raw hasta lista para extraccion
--
-- Excludes:
--   - Descarga real de YouTube (black box: YtDlp.descargar)
--   - Transcripcion de audio a texto (black box: TranscripcionAutomatica.transcribir)

use "./lectografo.allium" as lectografo
use "./edicion-texto.allium" as edicion
use "./multiusuario.allium" as multiusuario
use "./invitaciones.allium" as invitaciones

------------------------------------------------------------
-- Tipos auxiliares
------------------------------------------------------------

enum FuenteOrigen {
    texto_pegado
    archivo_local
    youtube
}

enum IdiomaSoportado {
    es
    en
    pt
    fr
    otro
}

value Timestamp_VTT {
    inicio: Duration
    fin: Duration
    duracion: fin - inicio
}

value Fragmento {
    indice: Integer
    texto: String
    timestamp: Timestamp_VTT?
}

------------------------------------------------------------
-- Entidades externas (black box)
------------------------------------------------------------

external entity YtDlp {
    binario_disponible: Boolean
}

external entity TranscripcionAutomatica {
    motor: String              -- por ejemplo "whisper", "faster-whisper"
    modelo: String
}

------------------------------------------------------------
-- Transcripcion
------------------------------------------------------------

entity Transcripcion {
    id: String                                   -- slug: en la app web se deriva del NOMBRE DE
                                                 -- ARCHIVO (minusculas, espacios a _, hasta 50
                                                 -- caracteres). Unico solo dentro de su biblioteca;
                                                 -- NO entre bibliotecas (ver multiusuario.allium,
                                                 -- RiesgoSlugNoUnico).
    biblioteca: multiusuario/Biblioteca          -- unica; Grafo y PuntoDecision la heredan
    -- Acceso explicito por texto, independiente de su ubicacion y de quien
    -- lo subio. Los textos anteriores se incorporan al operar sobre ellos.
    personas_con_acceso: Set<multiusuario/Persona>
    titulo: String
    fuente_origen: FuenteOrigen
    url_fuente: String?
    autor_contenido: String?                     -- quien analiza
    autor_texto_original: String?                -- el filosofo discutido
    idioma: IdiomaSoportado
    fecha_ingesta: Timestamp

    texto_crudo: String
    fragmentos: List<Fragmento>                  -- texto normalizado por partes
    tiene_timestamps: Boolean

    estado: raw | normalizada | extraida | validada | publicada
    fecha_normalizacion: Timestamp? when estado != raw
    fecha_extraccion: Timestamp? when estado = extraida | validada | publicada
    fecha_validacion: Timestamp? when estado = validada | publicada
    fecha_publicacion: Timestamp? when estado = publicada

    transitions estado {
        raw -> normalizada
        normalizada -> extraida
        extraida -> validada
        validada -> publicada
        extraida -> normalizada       -- ResetearGrafo (grafo.allium)
        validada -> normalizada       -- ResetearGrafo (grafo.allium)
        terminal: publicada
        -- Nota: el estado nunca retrocede aunque el texto sea editado.
        -- Ver edicion-texto.allium para el modelo de edición y re-extracción.
        -- La unica vuelta atras es el reset explicito del grafo completo.
    }

    -- Historial de ediciones (ver edicion-texto.allium)
    revisiones: List<edicion/RevisionTexto>              -- crece con cada EditarTextoTranscripcion
    texto_desincronizado_desde: Timestamp?               -- null si el texto coincide con la última extracción
    fragmentos_invalidos: Boolean                        -- true si texto_crudo cambió tras la última normalización
}

------------------------------------------------------------
-- Ingesta
------------------------------------------------------------

rule IngestarTextoPegado {
    when: InvestigadorIngresaTexto(biblioteca, titulo, texto, idioma, autor_contenido?, autor_texto_original?)

    requires: length(texto) > 0
    requires: not exists Transcripcion{titulo: titulo, biblioteca: biblioteca}

    ensures: Transcripcion.created(
        id: slugify(titulo),
        biblioteca: biblioteca,
        personas_con_acceso: personas_iniciales(biblioteca),
        titulo: titulo,
        fuente_origen: texto_pegado,
        autor_contenido: autor_contenido,
        autor_texto_original: autor_texto_original,
        idioma: idioma,
        fecha_ingesta: now,
        texto_crudo: texto,
        fragmentos: [],
        tiene_timestamps: false,
        estado: raw
    )
}

rule IngestarArchivoLocal {
    when: InvestigadorIngresaArchivo(biblioteca, ruta, titulo, idioma)

    requires: archivo_existe(ruta)
    requires: extension(ruta) in {"txt", "md", "vtt", "srt"}
    requires: not exists Transcripcion{titulo: titulo, biblioteca: biblioteca}

    ensures: Transcripcion.created(
        id: slugify(titulo),
        biblioteca: biblioteca,
        personas_con_acceso: personas_iniciales(biblioteca),
        titulo: titulo,
        fuente_origen: archivo_local,
        url_fuente: ruta,
        idioma: idioma,
        fecha_ingesta: now,
        texto_crudo: leer_archivo(ruta),         -- black box
        fragmentos: [],
        tiene_timestamps: extension(ruta) in {"vtt", "srt"},
        estado: raw
    )
}

rule IngestarYoutube {
    when: InvestigadorIngresaUrl(biblioteca, url, titulo, idioma)

    requires: es_url_https(url)
    requires: dominio(url) in {"youtube.com", "youtu.be"}
    requires: not exists Transcripcion{titulo: titulo, biblioteca: biblioteca}

    ensures:
        let texto = YtDlp.descargar_subtitulos(url) ?? TranscripcionAutomatica.transcribir(YtDlp.descargar_audio(url))
        Transcripcion.created(
            id: slugify(titulo),
            biblioteca: biblioteca,
            personas_con_acceso: personas_iniciales(biblioteca),
            titulo: titulo,
            fuente_origen: youtube,
            url_fuente: url,
            idioma: idioma,
            fecha_ingesta: now,
            texto_crudo: texto,
            fragmentos: [],
            tiene_timestamps: true,
            estado: raw
        )

    @guidance
        -- Preferir siempre subtitulos oficiales sobre transcripcion automatica.
        -- La transcripcion automatica solo se invoca si YtDlp.descargar_subtitulos
        -- retorna null.
}

------------------------------------------------------------
-- Normalizacion
------------------------------------------------------------

rule NormalizarTranscripcion {
    when: InvestigadorSolicitaNormalizacion(transcripcion)

    requires: transcripcion.estado = raw
    requires: length(transcripcion.texto_crudo) <= lectografo/config.max_chars_por_prompt * 10

    let fragmentos_limpios = particionar_y_limpiar(transcripcion.texto_crudo, transcripcion.tiene_timestamps)

    ensures:
        transcripcion.fragmentos = fragmentos_limpios
        transcripcion.estado = normalizada
        transcripcion.fecha_normalizacion = now
        TranscripcionNormalizada(transcripcion: transcripcion)

    @guidance
        -- particionar_y_limpiar es una funcion caja negra. A nivel de comportamiento
        -- garantiza: (1) elimina muletillas configuradas, (2) preserva citas directas,
        -- (3) conserva timestamps si el origen los tenia.
}

------------------------------------------------------------
-- Eliminacion
------------------------------------------------------------

-- Implementado: sustituye el borrado global directo.
rule RetirarTextoDeMiBiblioteca {
    when: InvestigadorEliminaTexto(persona, transcripcion)
    requires: persona in transcripcion.personas_con_acceso
    let restantes = transcripcion.personas_con_acceso - {persona}
    ensures:
        transcripcion.personas_con_acceso = restantes
        for p in multiusuario/PermisoCompartido where biblioteca_origen = transcripcion.biblioteca and slug = transcripcion.id and beneficiaria = persona:
            not exists p
        for i in invitaciones/Invitacion where biblioteca_origen = transcripcion.biblioteca and slug = transcripcion.id and aceptada_por = persona:
            i.estado = retirada
        if restantes.count = 0:
            TextoSinPersonasConAcceso(transcripcion)

    @guidance
        -- Eliminar significa salir del texto: desaparece de MI biblioteca y
        -- pierdo acceso de lectura y escritura autenticadas de inmediato.
        -- Vale igual para quien lo subio y para quienes lo recibieron.
        -- La biblioteca de origen solo ubica el texto: no restaura el acceso
        -- de quien salio ni obliga a transferirlo o copiarlo a otra biblioteca.
        -- Si queda alguien, conserva el texto, grafo, revisiones y TODAS las
        -- glosas con su autoria, incluidas las de quien sale. Tambien conserva
        -- los permisos de terceros, aunque los haya otorgado quien sale.
        -- Ni un permiso duplicado ni una invitacion aceptada antigua vuelven
        -- a conceder acceso; volver requiere una nueva accion de compartir.
}

rule EliminarTextoCompleto {
    when: TextoSinPersonasConAcceso(transcripcion)
    requires: transcripcion.personas_con_acceso.count = 0
    ensures:
        for p in multiusuario/PermisoCompartido where biblioteca_origen = transcripcion.biblioteca and slug = transcripcion.id:
            not exists p
        for p in multiusuario/Publicacion where biblioteca_origen = transcripcion.biblioteca and slug = transcripcion.id:
            not exists p
        for i in invitaciones/Invitacion where biblioteca_origen = transcripcion.biblioteca and slug = transcripcion.id:
            i.estado = invalidada
        not exists transcripcion

    @guidance
        -- Borrado irreversible del texto fuente y de TODO su contenido
        -- asociado: grafo, conceptos, relaciones, glosas, revisiones y sesiones.
        -- No deja enlaces activos ni accesos que resurjan si se reutiliza el
        -- slug. Invitaciones pendientes y lectores anonimos no cuentan como
        -- personas con acceso en su biblioteca; no impiden este borrado.
        -- La salida y la comprobacion de la ultima persona forman una sola
        -- operacion coherente frente a salidas o aceptaciones concurrentes.
        -- Mientras una operacion o tarea trabaja sobre el texto, la salida se
        -- rechaza con una indicacion para reintentar al terminar.
        -- Ante un fallo no se informa exito ni se pierde el trabajo de otra
        -- persona. Una tarea iniciada antes no puede resucitar el texto borrado.
}

------------------------------------------------------------
-- Invariantes locales
------------------------------------------------------------

invariant TimestampsCoherentes {
    for t in Transcripcion:
        for f in t.fragmentos:
            f.timestamp = null or f.timestamp.inicio < f.timestamp.fin
}

invariant IdiomaCoincideConIdiomaSoportado {
    for t in Transcripcion:
        t.idioma in {es, en, pt, fr, otro}
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred personas_iniciales    -- see: src/acceso_texto.py: personas_legacy
    -- (biblioteca: multiusuario/Biblioteca) -> Set<multiusuario/Persona>
    -- Personas con acceso al texto al crearlo. En el modelo actual es la
    -- persona fundadora de la biblioteca; nunca incluye invitaciones pendientes.

------------------------------------------------------------
-- Preguntas abiertas
------------------------------------------------------------

open question "Cuando una transcripcion supera diez veces el max_chars_por_prompt el sistema rechaza la ingesta. Es preferible permitir ingesta y obligar a fragmentacion explicita por capitulos?"

open question "Si el investigador ingresa dos veces la misma URL de YouTube con titulos distintos, el sistema deberia detectar la duplicacion por url_fuente?"
