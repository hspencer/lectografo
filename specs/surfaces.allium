-- allium: 3
-- surfaces.allium

-- Scope: contratos de superficie del sistema. Define las fronteras entre
-- el sistema y sus actores (investigador y LLM) sin describir interfaz
-- grafica ni endpoints HTTP concretos.
--
-- Includes:
--   - Actor Investigador (humano) y actor LLM (servicio externo)
--   - Surface de validacion de decisiones
--   - Surface del mapa con tarjetas de concepto encadenadas
--   - Surfaces de tabla: conceptos (con pasajes) y relaciones
--   - Surface de invocacion del LLM
--   - Contrato Codec para serializar grafos
--   - Contrato EvaluadorLLM para invocar proveedores

use "./transcripcion.allium" as transcripcion
use "./extraccion.allium" as extraccion
use "./validacion.allium" as validacion
use "./grafo.allium" as grafo
use "./extraccion-incremental.allium" as extraccionIncremental
use "./edicion-texto.allium" as edicion
use "./recorrido.allium" as recorrido

------------------------------------------------------------
-- Actores
------------------------------------------------------------

external entity Persona {
    nombre: String
    email: String?
}

external entity ServicioLLM {
    proveedor: extraccion/ProveedorLLM
    endpoint: String
}

actor Investigador {
    identified_by: Persona where nombre != ""
}

actor LLM {
    identified_by: ServicioLLM where proveedor in {anthropic, openai, gemini, ollama, lmstudio}
}

------------------------------------------------------------
-- Contratos
------------------------------------------------------------

contract Codec {
    serializar: (g: grafo/Grafo) -> ByteArray
    deserializar: (bytes: ByteArray) -> grafo/Grafo

    @invariant Roundtrip
        -- deserializar(serializar(g)) recupera un grafo equivalente
        -- en todos los campos observables.

    @guidance
        -- El formato concreto es JSON-LD. El codec no debe perder
        -- anotaciones del investigador ni notas_usuario.
}

contract EvaluadorLLM {
    invocar: (prompt: String, transcripcion: transcripcion/Transcripcion, on_token: (Integer -> Void)?) -> String
    -- on_token: callback opcional invocado en cada token generado; permite progreso en tiempo real y cancelación.
    parsear_respuesta: (texto: String) -> (List<extraccion/ConceptoPropuesto>, List<extraccion/RelacionPropuesta>, List<extraccion/BucleDetectado>, List<extraccion/FlagMetalenguaje>)

    @invariant ParseoEsTotal
        -- parsear_respuesta nunca lanza excepcion: para input invalido
        -- retorna listas vacias y la falla se reporta por otro canal.

    @guidance
        -- Cada proveedor (anthropic, openai, gemini, ollama, lmstudio)
        -- implementa este contrato detras de la misma interfaz. lmstudio
        -- habla la API compatible con OpenAI que LM Studio expone en local;
        -- comparte con openai el protocolo, no la configuracion.
}

------------------------------------------------------------
-- Enumeraciones
------------------------------------------------------------

enum ModoMapa {
    tridimensional
    bidimensional
}

------------------------------------------------------------
-- Configuracion
------------------------------------------------------------

config {
    -- Modo con que se abre el mapa de un grafo derivado (editor y sitio
    -- publicado). El investigador lo alterna con un unico control; la
    -- eleccion dura mientras la pagina siga abierta y no se guarda.
    -- (El mapa de un grafo personal tiene su propio modo y abre en 2D.)
    modo_mapa_inicial: ModoMapa = tridimensional
}

------------------------------------------------------------
-- Surface: panel de validacion del investigador
------------------------------------------------------------

surface PanelValidacion {
    facing investigador: Investigador
    context transcripcion: transcripcion/Transcripcion where estado in {extraida, validada}

    let pendientes = validacion/PuntoDecision where transcripcion = transcripcion and estado = pendiente
    let diferidas = validacion/PuntoDecision where transcripcion = transcripcion and estado = diferida
    let estancadas = pendientes where esta_estancada = true

    exposes:
        pendientes
        diferidas
        estancadas
        for d in pendientes:
            d.pregunta
            d.recomendacion_llm
            d.tipo
            d.conceptos_implicados
            d.relacion_implicada
            d.bucle_implicado
            d.flag_implicado

    provides:
        InvestigadorResuelve(decision, aceptada, nota)
            when decision in pendientes
        InvestigadorResuelve(decision, rechazada, nota)
            when decision in pendientes
        InvestigadorResuelve(decision, modificada, nota)
            when decision in pendientes
        InvestigadorResuelve(decision, diferida, nota)
            when decision in pendientes
        InvestigadorReanudaDecision(decision)
            when decision in diferidas
        InvestigadorAgregaNota(transcripcion, objeto, nota)

    @guarantee NingunaDecisionSeCierraAutomaticamente
        -- El sistema nunca resuelve una decision sin accion explicita
        -- del investigador. Los timeouts solo marcan decisiones como
        -- estancadas, no las cierran.

    @guarantee TrazabilidadDeDecisiones
        -- Toda decision resuelta queda con timestamp y nota; las
        -- decisiones rechazadas no se borran, persisten para el
        -- registro hermeneutico.

    timeout:
        DecisionEstancadaSeDestaca when pendientes.any(d => d.esta_estancada)
}

------------------------------------------------------------
-- Surface: mapa del grafo con tarjetas de concepto
------------------------------------------------------------

-- NOTA: Esta surface fue la vista principal hasta que se comprobó que con
-- grafos de más de ~15 nodos las frases de relación (frase_completa) son
-- completamente ilegibles SOBRE EL MAPA: los labels se superponen, los
-- arcos se cruzan y no existe punto de entrada natural para la lectura.
-- Esa conclusión sigue en pie: el mapa no dibuja frases sobre las aristas.
--
-- Lo que cambió es dónde ocurre la lectura. Ya no se desplaza a otra vista:
-- se superpone al mapa en TARJETAS FLOTANTES, una por concepto abierto,
-- encadenadas por flechas que siguen la dirección de cada relación cruzada.
-- El conjunto de tarjetas abiertas es el estado de los recorridos en curso
-- (recorrido/RecorridosAbiertos); el mapa resalta esos mismos pasos. El mapa
-- es el soporte espacial del recorrido; las tarjetas, su registro
-- discursivo. Ver recorrido.allium, "La doble inscripcion".
--
-- La misma surface se publica en el sitio estático en modo de solo
-- lectura: allí cada tarjeta muestra Concepto y Relaciones, sin Anotaciones
-- ni Vincular, y no se ofrece ninguna acción que escriba sobre el grafo.

surface VisualizacionGrafo {
    facing investigador: Investigador
    context grafo: grafo/Grafo

    let abiertos = TarjetasAbiertas(grafo)
    let modo = ModoMapaActivo(grafo)

    exposes:
        modo
        -- Cada tarjeta abierta es un paso de recorrido (nodo, arista, sentido)
        for p in abiertos.pasos:
            p.nodo.label                    -- cabecera de la tarjeta
            p.direccion                     -- punta(s) de la flecha hacia el paso padre
            p.relacion_entrada.tipo         -- rotulo de la flecha
            -- Secciones, todas plegadas al abrir, en este orden:
            --   Concepto     descripcion, cita directa, menciones, confianza, sinonimos
            --   Relaciones   las conexiones del nodo (ver recorrido/OrdenDeLaOferta)
            --   Anotaciones  validacion/AnotacionInvestigador sobre el concepto
            --   Vincular     formulario para crear una relacion autoral
            p.nodo.descripcion_corta
            p.nodo.sinonimos_consolidados
        grafo.titulo
        grafo.version
        grafo.total_nodos
        grafo.total_relaciones
        grafo.densidad
        for n in grafo.nodos:
            n.label
            n.tipos
            n.descripcion_corta
            n.sinonimos_consolidados
            n.notas_usuario
        for r in grafo.relaciones:
            r.etiqueta
            r.frase_completa
            r.bidireccional
            r.matiz
            r.tipo
        for b in grafo.bucles:
            b.descripcion
            b.tipo
            b.nodos

    provides:
        InvestigadorSeleccionaConcepto(grafo, nodo)
            -- Clic sobre el nodo en el mapa, o eleccion en el buscador con
            -- autocompletar. Abre una tarjeta raiz (recorrido/RecorridosAbiertos.abrir_raiz).
            -- Si ya hay una tarjeta raiz para ese nodo, la enfoca en vez de duplicarla.
            -- Un clic en el fondo del mapa no cierra nada.
        InvestigadorSigueRelacion(paso, arista)
            -- Clic en una relacion de la seccion Relaciones de una tarjeta.
            -- Encadena una tarjeta hija (recorrido/RecorridosAbiertos.avanzar).
            -- Si esa misma relacion ya se siguio desde esa tarjeta, enfoca la
            -- hija existente en vez de duplicarla.
        InvestigadorEnfocaTarjeta(paso)
            -- Cualquier interaccion con una tarjeta (arrastrarla, hacer clic
            -- dentro) la trae al frente y reencuadra el mapa sobre su concepto.
        InvestigadorCierraTarjeta(paso)
            -- Cierra la tarjeta y, en cascada, todas sus descendientes
            -- (recorrido/RecorridosAbiertos.podar).
        InvestigadorAlternaModoMapa(grafo)
            -- Un unico control alterna tridimensional <-> bidimensional.
            -- Las tarjetas abiertas sobreviven al cambio de modo.
        InvestigadorAjustaVista(grafo)
            -- Reencuadra el mapa para que quepa el grafo completo.
        InvestigadorAgregaNota(grafo.transcripcion, objeto, nota)
            -- Desde la seccion Anotaciones de una tarjeta; objeto = el nodo.
        InvestigadorCreaRelacion(grafo, origen, destino, tipo, etiqueta, bidireccional)
            -- Desde la seccion Vincular de una tarjeta; origen = el nodo de la
            -- tarjeta. Crea una relacion por la via autoral (ver recorrido.allium,
            -- "Via 3"). Tras crearla se rehace el contenido de todas las tarjetas
            -- abiertas, porque sus listas de relaciones pueden haber cambiado.

    related:
        PanelValidacion(grafo.transcripcion)
        TablaConceptos(grafo)
        TablaRelaciones(grafo)

    contracts:
        demands Codec

    @guarantee VistaInicialSegunConfig
        -- Al abrir un grafo, el mapa se muestra en config.modo_mapa_inicial
        -- (tridimensional). El control de alternancia indica visiblemente
        -- cuando el modo tridimensional esta activo.

    @guarantee TarjetasNacenPlegadas
        -- Toda tarjeta se abre con todas sus secciones plegadas: al abrirla
        -- solo se ve el nombre del concepto. El investigador despliega lo que
        -- quiere leer. Las tarjetas se pueden arrastrar, redimensionar,
        -- plegar enteras y cerrar.

    @guarantee FlechaSigueLaDireccionDeLaRelacion
        -- La flecha que une una tarjeta hija con su padre representa la
        -- relacion cruzada en su sentido INSCRITO, no en el sentido del
        -- recorrido ni en el orden de apertura:
        --   saliente       punta hacia la tarjeta hija
        --   entrante       punta hacia la tarjeta padre
        --   bidireccional  punta en ambos extremos
        -- Al mover o redimensionar las tarjetas, el lado por donde la flecha
        -- se ancla a cada una se recalcula segun su posicion relativa actual;
        -- el sentido de las puntas no cambia.

    @guarantee MapaYTarjetasSeResaltanJuntos
        -- Cada vez que se abre o cierra una tarjeta, el mapa resalta el
        -- conjunto de los nodos de todas las tarjetas abiertas y de sus
        -- relaciones de entrada. El ultimo paso abierto es el foco.

    @guarantee VincularEligeDestinoDeLaLista
        -- El concepto destino se elige con un buscador con autocompletar
        -- sobre los conceptos del grafo, excluido el propio, que marca los
        -- que ya estan vinculados con el. Escribir en el buscador invalida
        -- la eleccion previa: no se crea la relacion sin un destino elegido
        -- de la lista ni sin etiqueta. El tipo tambien se escribe en un
        -- campo con autocompletar — sugiere extraccion/TipoRelacion mas los
        -- tipos ya presentes en el grafo, pero acepta cualquier texto libre
        -- (ontologia abierta, igual que TablaRelaciones y el grafo personal).

    @guidance
        -- El investigador puede arrastrar nodos y hacer zoom; la legibilidad
        -- del mapa como tal se degrada con densidad alta. La lectura del
        -- argumento ocurre en las tarjetas, no en las etiquetas del mapa.
}

------------------------------------------------------------
-- Surfaces: tablas de conceptos y de relaciones
------------------------------------------------------------

surface TablaConceptos {
    facing investigador: Investigador
    context grafo: grafo/Grafo

    let expandido = ConceptoExpandido(grafo)        -- a lo sumo uno, o null

    exposes:
        for n in grafo.nodos:
            n.label
            n.sinonimos_consolidados
            n.conceptos_origen                       -- de aqui salen menciones y confianza
        PasajesDeConcepto(expandido, grafo.transcripcion)
            when expandido != null

    provides:
        InvestigadorFiltraConceptos(grafo, texto)
            -- Filtra por coincidencia en el label o la descripcion.
        InvestigadorExpandeConcepto(grafo, nodo)
            -- Clic en la fila. Alterna: expande ese concepto (y pliega el que
            -- estuviera expandido) o lo pliega si ya lo estaba.
        InvestigadorEditaConcepto(grafo, nodo, label)

    related:
        TablaRelaciones(grafo)
        VisualizacionGrafo(grafo)

    @guarantee PasajesSonTodasLasMenciones
        -- Al expandir un concepto se muestran TODOS los pasajes del texto
        -- fuente que lo mencionan, no solo la cita_directa unica que guardo
        -- la extraccion. Ver PasajesDeConcepto.
        -- Si no hay ninguno, se dice explicitamente que no se encontraron
        -- pasajes literales.
}

surface TablaRelaciones {
    facing investigador: Investigador
    context grafo: grafo/Grafo

    let expandida = RelacionExpandida(grafo)        -- a lo sumo una, o null
    let tipos_presentes = TiposPresentes(grafo)

    exposes:
        for r in grafo.relaciones:
            r.origen.label
            r.tipo
            r.destino.label
            r.bidireccional
            r.confianza_extraccion
            r.etiqueta
        tipos_presentes
        expandida.origen.label when expandida != null
        expandida.tipo when expandida != null
        expandida.destino.label when expandida != null

    provides:
        InvestigadorFiltraRelacionesPorTipo(grafo, tipo?)
            -- Un solo tipo entre tipos_presentes, o todos (tipo ausente).
        InvestigadorBuscaRelaciones(grafo, texto)
            -- Coincidencia en la etiqueta, el tipo, o el label del concepto
            -- origen o destino. Se combina con el filtro por tipo.
        InvestigadorExpandeRelacion(grafo, relacion)
            -- Clic en la fila. Alterna, igual que en TablaConceptos.
        InvestigadorVaAConcepto(grafo, nodo)
            when expandida != null
            -- nodo es expandida.origen o expandida.destino. Lleva a
            -- TablaConceptos con ese concepto expandido y desplazado a la vista.
        InvestigadorAlternaBidireccionalidad(grafo, relacion)
        InvestigadorEditaRelacion(grafo, relacion, tipo?, etiqueta?)
            -- El tipo se edita como texto libre (ontologia abierta).

    related:
        TablaConceptos(grafo)
        VisualizacionGrafo(grafo)

    @guarantee FiltroPorTipoNoCreceConLaOntologia
        -- El tipo es texto libre: un grafo puede tener cientos de tipos
        -- casi unicos. El filtro por tipo es un unico selector con
        -- tipos_presentes en orden alfabetico, mas la opcion "todos"; su
        -- presencia en la superficie no aumenta con el numero de tipos.

    @guarantee ParOrdenadoRespetaLaInscripcion
        -- La relacion expandida se muestra como el par ordenado
        -- origen — tipo — destino, en el sentido en que fue inscrita,
        -- tambien cuando es bidireccional (ver recorrido.allium, Parte II).
        -- Cada extremo es un enlace a ese concepto en TablaConceptos.
}

------------------------------------------------------------
-- Surface: mapa conceptual en construcción
------------------------------------------------------------

surface VisualizacionGrafoEnConstruccion {
    -- Mapa conceptual que crece en tiempo real mientras el LLM procesa
    -- el texto frase a frase. El investigador es espectador puro.
    -- Al completarse la sesión, esta vista cede lugar a VisualizacionGrafo.
    facing investigador: Investigador
    context sesion: extraccionIncremental/SesionExtraccionIncremental where estado = activa

    -- Nodos y relaciones ya materializados hasta este momento
    let nodos_actuales = NodosParcialesDeSesion(sesion)
    let relaciones_actuales = RelacionesParcialesdeSesion(sesion)

    exposes:
        sesion.transcripcion.titulo
        sesion.porcentaje_avance
        sesion.frases_procesadas
        sesion.total_frases
        sesion.frase_en_curso
        -- Nodos del grafo en construcción
        for n in nodos_actuales:
            n.label
            n.tipo
            n.es_nuevo_en_sesion
            -- es_nuevo_en_sesion: false si el nodo ya existía en grafo_preexistente
        -- Relaciones del grafo en construcción
        for r in relaciones_actuales:
            r.etiqueta
            r.origen.label
            r.destino.label
            r.es_nueva_en_sesion

    provides:
        InvestigadorAbortaSesion(sesion)

    transitions:
        when sesion.estado = completada -> VisualizacionGrafo(sesion.grafo_resultante)

    @guarantee InvestigadorEsEspectador
        -- Esta surface no permite editar el grafo en construcción.
        -- La única acción disponible es abortar la sesión.
        -- Las propuestas de consolidación se acumulan en segundo plano
        -- sin interrumpir la visualización ni requerir atención inmediata.

    @guarantee NodosAparecenAlInstante
        -- Cada ResultadoParcial nuevo causa que los nodos y relaciones
        -- detectados en esa frase aparezcan en el mapa inmediatamente,
        -- sin esperar al fin de la sesión ni al siguiente lote.

    @guarantee NodosExistentesSeDistinguen
        -- Los conceptos reconocidos como equivalentes a nodos del
        -- grafo_preexistente se muestran diferenciados de los nodos
        -- nuevos, pero se destacan visualmente al recibir nueva evidencia.
}

------------------------------------------------------------
-- Surface: invocacion del LLM
------------------------------------------------------------

surface InvocacionLLM {
    facing servicio: LLM
    context ejecucion: extraccion/EjecucionExtraccion where estado = en_curso

    exposes:
        ejecucion.transcripcion.texto_crudo
        ejecucion.transcripcion.fragmentos
        ejecucion.prompt.plantilla
        ejecucion.transcripcion.idioma

    provides:
        ExtraccionLLMRetornaResultado(ejecucion, conceptos, relaciones, bucles, metalenguaje)
        ExtraccionLLMRetornaError(ejecucion, razon)

    contracts:
        demands EvaluadorLLM

    @guarantee SinFugaDeDatos
        -- La unica informacion que cruza esta surface hacia el servicio
        -- LLM es la transcripcion y el prompt. No se envian anotaciones
        -- previas del investigador ni grafos en curso.

    @guarantee RespuestaJSONValida
        -- La respuesta del LLM debe ser JSON parseable. Si no lo es,
        -- se emite ExtraccionLLMRetornaError con razon = "json_invalido".

    timeout:
        ExtraccionLLMTimeout when ejecucion.iniciada_en + 5.minutes <= now
}

------------------------------------------------------------
-- Reglas de timeout (deben tener guarda como dice la guidance global)
------------------------------------------------------------

rule MarcarDecisionEstancada {
    when: d: validacion/PuntoDecision.creada_en + config.plazo_decision_estancada <= now
    requires: d.estado = pendiente

    ensures: DecisionEstancadaSeDestaca(decision: d)

    @guidance
        -- Esta regla no cierra la decision. Solo emite un trigger que
        -- el panel usa para destacar visualmente la decision como
        -- estancada.
}

rule AbortarExtraccionPorTimeout {
    when: e: extraccion/EjecucionExtraccion.iniciada_en + 5.minutes <= now
    requires: e.estado = en_curso

    ensures: ExtraccionLLMRetornaError(ejecucion: e, razon: "timeout")
}

rule CancelarExtraccion {
    when: CancelarExtraccion(ejecucion)
    requires: ejecucion.estado = en_curso
    ensures:
        ejecucion.estado = fallida
        ejecucion.finalizada_en = now
        ejecucion.razon_falla = "cancelado_por_investigador"
        ejecucion.transcripcion.estado = normalizada
        -- La transcripción vuelve a estado normalizada: puede procesarse de nuevo.
}

------------------------------------------------------------
-- Surface: configuracion del proveedor LLM
------------------------------------------------------------

surface ConfiguracionProveedor {
    facing investigador: Investigador
    context activo: extraccion/ProveedorActivo

    let modelos_locales = ModelosLocalesDisponibles(activo)

    exposes:
        activo.proveedor
        activo.modelo
        activo.api_key_presente when activo.es_local = false
        modelos_locales when activo.es_local = true

    provides:
        InvestigadorSeleccionaProveedor(proveedor, modelo)
            when proveedor in {anthropic, openai, gemini}
            -- modelo: de una lista sugerida por proveedor, o un nombre libre.
            -- Se rechaza si la api_key de ese proveedor no esta configurada.
        InvestigadorSeleccionaProveedorLocal(proveedor, modelo)
            when proveedor in {ollama, lmstudio}
            -- modelo: elegido de la lista que devuelve en ese momento el
            -- endpoint local del proveedor. Si el endpoint no responde, no
            -- hay modelos que elegir y la surface lo dice.
            -- El endpoint local no se elige aqui: es configuracion del
            -- sistema (por defecto Ollama en :11434, LM Studio en :1234/v1).

    @guarantee ApiKeyNuncaSeExpone
        -- La api_key de proveedores remotos no aparece en ninguna surface
        -- ni en la serializacion del grafo. Esta surface solo indica si
        -- esta presente o no; se configura fuera de la aplicacion.
}

------------------------------------------------------------
-- Surface: editor de texto fuente
------------------------------------------------------------

surface EditorTexto {
    -- Permite al investigador leer y editar el texto_crudo de una Transcripcion
    -- en cualquier estado. El texto se muestra renderizado como HTML
    -- (interpretando la sintaxis Markdown/txt del texto_crudo).
    facing investigador: Investigador
    context transcripcion: transcripcion/Transcripcion

    exposes:
        transcripcion.titulo
        transcripcion.estado
        transcripcion.texto_crudo                       -- como fuente del renderizado HTML
        transcripcion.texto_desincronizado_desde        -- null o timestamp de la última edición divergente
        transcripcion.fragmentos_invalidos
        transcripcion.revisiones                        -- historial completo de revisiones
        for rev in transcripcion.revisiones:
            rev.fecha
            rev.nota_autor
            -- texto_anterior disponible bajo demanda (puede ser voluminoso)

    provides:
        InvestigadorEditaTexto(transcripcion, texto_nuevo, nota?)
            -- Siempre disponible, en cualquier estado.
        InvestigadorSolicitaReNormalizacion(transcripcion)
            when transcripcion.fragmentos_invalidos = true
        InvestigadorConsultaRevision(revision)
            -- Muestra el texto_anterior completo de una revisión concreta.

    @guarantee TextoSiempreEditable
        -- InvestigadorEditaTexto está disponible independientemente del
        -- estado de la transcripcion. No existe bloqueo por estado.

    @guarantee HistorialNoEsDestructivo
        -- Ninguna acción en esta surface elimina revisiones existentes.
        -- El historial sólo crece; nunca se trunca.

    @guarantee DesincronizacionVisible
        -- Si texto_desincronizado_desde != null, la surface lo señala
        -- visiblemente antes de que el investigador pueda lanzar
        -- una nueva extracción.

    related:
        PanelBiblioteca
            when transcripcion.fragmentos_invalidos = false
                and transcripcion.estado = normalizada
}

------------------------------------------------------------
-- Surface: panel de biblioteca (vista principal)
------------------------------------------------------------

surface PanelBiblioteca {
    -- Vista principal de la aplicación: lista de textos disponibles,
    -- estado de cada uno, y control del proceso de extracción.
    facing investigador: Investigador

    exposes:
        -- Textos ya extraídos
        for t in transcripcion/Transcripcion where estado != raw:
            t.titulo
            t.estado
            t.metadatos
        -- Extracciones en curso: progreso en tokens
        for e in extraccion/EjecucionExtraccion where estado = en_curso:
            e.transcripcion.titulo
            e.tokens_generados       -- contador en tiempo real vía on_token
            e.tokens_total_estimado  -- estimación previa al inicio
            e.porcentaje_avance      -- tokens_generados * 100 / tokens_total_estimado, cap 90%
            e.elapsed                -- segundos desde iniciada_en

    provides:
        InvestigadorSolicitaExtraccion(transcripcion, proveedor, prompt)
            when transcripcion.estado = normalizada
        CancelarExtraccion(ejecucion)
            when ejecucion.estado = en_curso
        InvestigadorEditaMetadatos(transcripcion, metadatos)
            -- Editar ficha bibliográfica; funciona antes y después de extraer

    @guarantee ProgresoEnTiempoReal
        -- El conteo de tokens se actualiza en cada token generado,
        -- sin esperar al fin de la extracción. El porcentaje nunca
        -- supera el 90% hasta que la extracción completa.

    @guarantee CancelacionResponsiva
        -- Tras CancelarExtraccion, el proceso se detiene en el próximo token
        -- generado (< 1 segundo de latencia). Los archivos parciales no quedan
        -- escritos: la extracción cancelada deja el texto en estado normalizada.
}

------------------------------------------------------------
-- Deferred
------------------------------------------------------------

-- Las firmas van en comentario, con la misma convencion que recorrido.allium.

deferred NodosParcialesDeSesion    -- see: extraccion-incremental.allium
    -- (sesion: extraccionIncremental/SesionExtraccionIncremental) -> List<grafo/Nodo>
    -- Proyecta los ResultadoParciales acumulados hasta ahora en nodos
    -- del grafo (aplicando el tesauro y la equivalencia con grafo_preexistente).
    -- Devuelve el estado actual del grafo en construcción.

deferred RelacionesParcialesdeSesion    -- see: extraccion-incremental.allium
    -- (sesion: extraccionIncremental/SesionExtraccionIncremental) -> List<grafo/Relacion>
    -- Proyecta las relaciones detectadas hasta ahora en el grafo en construcción.

------------------------------------------------------------
-- Deferred: mapa, tarjetas y tablas
------------------------------------------------------------

deferred TarjetasAbiertas    -- see: static/floatcards.js: createFloatingCards
    -- (grafo: grafo/Grafo) -> recorrido/RecorridosAbiertos
    -- Las tarjetas abiertas sobre el mapa de este grafo. Estado en memoria
    -- de la pagina; vacio al abrir un grafo. Ver recorrido.allium.

deferred ModoMapaActivo    -- see: static/app.js: state.modo3d
    -- (grafo: grafo/Grafo) -> ModoMapa
    -- config.modo_mapa_inicial hasta que el investigador lo alterne.

deferred ConceptoExpandido    -- see: static/app.js: conceptoExpandidoId
    -- (grafo: grafo/Grafo) -> grafo/Nodo?
    -- El concepto cuya fila esta expandida en TablaConceptos, o null.

deferred RelacionExpandida    -- see: static/app.js: relacionExpandidaId
    -- (grafo: grafo/Grafo) -> grafo/Relacion?
    -- La relacion cuya fila esta expandida en TablaRelaciones, o null.

deferred TiposPresentes    -- see: static/app.js: initRelaciones
    -- (grafo: grafo/Grafo) -> List<String>
    -- Los valores distintos de tipo entre las relaciones del grafo, sin
    -- vacios, en orden alfabetico.

deferred PasajesDeConcepto    -- see: static/app.js: _pasajesDeConcepto
    -- (nodo: grafo/Nodo, transcripcion: transcripcion/Transcripcion) -> List<String>
    -- Las oraciones del texto fuente VIGENTE (el editado, si lo hay; si no,
    -- el original) que contienen el label del nodo o alguno de sus
    -- sinonimos, como subcadena y sin distinguir mayusculas.
    -- Cada oracion aparece una sola vez y en el orden del texto.
    -- Una oracion termina en . ! o ?; los espacios se normalizan antes de
    -- dividir. Es busqueda literal: no reconoce flexiones ni parafrasis.

deferred ModelosLocalesDisponibles    -- see: src/app.py: obtener_settings
    -- (activo: extraccion/ProveedorActivo) -> List<String>
    -- Los modelos que el endpoint local del proveedor activo reporta en el
    -- momento de consultar (ollama: modelos instalados; lmstudio: modelos
    -- que lista su API compatible con OpenAI). Lista vacia si no responde.

------------------------------------------------------------
-- Preguntas abiertas
------------------------------------------------------------

open question "El timeout de 5 minutos para la invocacion del LLM es razonable para transcripciones largas? Hacerlo proporcional al tamano del input?"

open question "La surface VisualizacionGrafo expone la densidad pero no expone la lista completa de bucles con sus tipos. Es informacion que el investigador quiere ver en el panel principal o solo bajo demanda?"

open question "VisualizacionGrafoEnConstruccion: ¿la frase actualmente en proceso se muestra en el mapa (p.ej. como tooltip o panel lateral con el texto fuente), o solo el mapa de nodos y relaciones?"

open question "¿Cuándo sesion.estado = abortada, la VisualizacionGrafoEnConstruccion cierra y muestra el grafo parcial hasta ese punto, o vuelve a PanelBiblioteca?"

-- DECISIÓN RESUELTA: El investigador selecciona el modelo local (Ollama o
-- LM Studio) de una lista consultada en tiempo real al endpoint del proveedor
-- (Ollama: /api/tags; LM Studio: /models de su API compatible con OpenAI).
-- El panel de configuración muestra los modelos disponibles y guarda la
-- selección en .env.

-- DECISIÓN RESUELTA: El mapa abre en 3D por defecto (config.modo_mapa_inicial)
-- con un único control para alternar a 2D, en una barra discreta de controles.

-- DECISIÓN RESUELTA: El navegador de columnas del mapa fue reemplazado por
-- tarjetas flotantes encadenadas (ver VisualizacionGrafo y recorrido.allium).

-- DECISIÓN RESUELTA: Las tarjetas flotantes encadenadas SUSTITUYEN al
-- NavegadorDendrograma: esa surface, sus value NodoEnContexto/Perspectiva y
-- sus deferred (NodoRaizActiva, PerspectvasActivas, ProyectarArbol) se
-- retiraron de este spec. La superficie de lectura primaria del grafo es
-- VisualizacionGrafo; la visualización force-directed es su soporte
-- espacial, no una vista secundaria aparte.

-- DECISIÓN RESUELTA: La sección Vincular de la tarjeta acepta tipo de
-- relación LIBRE (ontología abierta), igual que TablaRelaciones y el grafo
-- personal — ya no está restringida al vocabulario orientativo cerrado. El
-- campo se autocompleta con ese vocabulario mas los tipos ya presentes en
-- el grafo, pero admite cualquier texto. Ver VincularEligeDestinoDeLaLista.
